diff --git a/internal/sap/machine/dump.go b/internal/sap/machine/dump.go
new file mode 100644
index 0000000..7522d81
--- /dev/null
+++ b/internal/sap/machine/dump.go
@@ -0,0 +1,170 @@
+package machine
+
+// Dumping support for a browser-side SAP port.
+//
+// The guest images relocate deterministically: their bytes, their load bases
+// and the shim addresses they bind against are all fixed. So the
+// post-relocation memory image is reproducible, and can be produced once at
+// build time instead of reimplementing the Mach-O loader and the dyld
+// bind/rebase opcode machines in the browser.
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+)
+
+type DumpRegion struct {
+	Name    string `json:"name"`
+	Address uint64 `json:"address"`
+	Size    uint64 `json:"size"`
+	Blob    string `json:"blob,omitempty"`
+	SHA256  string `json:"sha256,omitempty"`
+	Data    []byte `json:"-"`
+}
+
+type DumpSymbol struct {
+	Name    string `json:"name"`
+	Address uint64 `json:"address"`
+}
+
+type DumpEntryPoints struct {
+	Initialize uint64 `json:"initialize"`
+	Exchange   uint64 `json:"exchange"`
+	Sign       uint64 `json:"sign"`
+	Teardown   uint64 `json:"teardown"`
+	Dispose    uint64 `json:"dispose"`
+}
+
+type DumpLayout struct {
+	ReturnAddress uint64 `json:"returnAddress"`
+	ScratchBase   uint64 `json:"scratchBase"`
+	ScratchSize   uint64 `json:"scratchSize"`
+	HeapBase      uint64 `json:"heapBase"`
+	HeapSize      uint64 `json:"heapSize"`
+	StackBase     uint64 `json:"stackBase"`
+	StackSize     uint64 `json:"stackSize"`
+	ShimBase      uint64 `json:"shimBase"`
+	ShimCodeSize  uint64 `json:"shimCodeSize"`
+	ShimSize      uint64 `json:"shimSize"`
+	PageSize      uint64 `json:"pageSize"`
+	MaxOutputSize uint64 `json:"maxOutputSize"`
+}
+
+type Dump struct {
+	Regions     []DumpRegion    `json:"regions"`
+	Symbols     []DumpSymbol    `json:"symbols"`
+	EntryPoints DumpEntryPoints `json:"entryPoints"`
+	Layout      DumpLayout      `json:"layout"`
+	// Addresses inside the images themselves, which the platform shims need
+	// and the shim table does not carry.
+	Exports []DumpSymbol `json:"exports"`
+}
+
+// Dump reads back everything the loader wrote into the guest.
+func (m *Machine) Dump() (*Dump, error) {
+	if m.closed {
+		return nil, errors.New("SAP runtime is closed")
+	}
+
+	if m.services == nil {
+		return nil, errors.New("SAP runtime has no shim table")
+	}
+
+	out := &Dump{
+		EntryPoints: DumpEntryPoints{
+			Initialize: m.entry.initialize,
+			Exchange:   m.entry.exchange,
+			Sign:       m.entry.sign,
+			Teardown:   m.entry.teardown,
+			Dispose:    m.entry.dispose,
+		},
+		Layout: DumpLayout{
+			ReturnAddress: returnAddress,
+			ScratchBase:   scratchBase,
+			ScratchSize:   scratchSize,
+			HeapBase:      heapBase,
+			HeapSize:      heapSize,
+			StackBase:     stackBase,
+			StackSize:     stackSize,
+			ShimBase:      shimBase,
+			ShimCodeSize:  shimCodeSize,
+			ShimSize:      shimSize,
+			PageSize:      pageSize,
+			MaxOutputSize: maxOutputSize,
+		},
+	}
+
+	type span struct {
+		name    string
+		address uint64
+		size    uint64
+	}
+
+	// Regions the loader populated: the return trampoline holds one HLT, the
+	// shim area holds the RET stubs and data blobs, the images their segments.
+	populated := []span{
+		{"return", returnAddress, pageSize},
+		{"shims", shimBase, shimSize},
+	}
+
+	names := []string{"CoreFP", "CommerceCore", "CommerceKit"}
+	for index, image := range m.images {
+		base, extent := image.LoadedRange()
+		if extent == 0 {
+			return nil, fmt.Errorf("image %d reports an empty load span", index)
+		}
+
+		name := fmt.Sprintf("image%d", index)
+		if index < len(names) {
+			name = names[index]
+		}
+
+		populated = append(populated, span{name, base, extent})
+	}
+
+	for _, item := range populated {
+		data, err := m.engine.MemRead(item.address, item.size)
+		if err != nil {
+			return nil, fmt.Errorf("read %s at %#x: %w", item.name, item.address, err)
+		}
+
+		out.Regions = append(out.Regions, DumpRegion{
+			Name:    item.name,
+			Address: item.address,
+			Size:    item.size,
+			Data:    data,
+		})
+	}
+
+	// Regions the guest allocates into start zeroed, so only geometry matters.
+	for _, item := range []span{
+		{"scratch", scratchBase, scratchSize},
+		{"heap", heapBase, heapSize},
+		{"stack", stackBase, stackSize},
+	} {
+		out.Regions = append(out.Regions, DumpRegion{
+			Name:    item.name,
+			Address: item.address,
+			Size:    item.size,
+		})
+	}
+
+	for name, address := range m.services.symbols {
+		out.Symbols = append(out.Symbols, DumpSymbol{Name: name, Address: address})
+	}
+
+	sort.Slice(out.Symbols, func(a, b int) bool {
+		return out.Symbols[a].Address < out.Symbols[b].Address
+	})
+
+	for name, address := range m.imageExports {
+		out.Exports = append(out.Exports, DumpSymbol{Name: name, Address: address})
+	}
+
+	sort.Slice(out.Exports, func(a, b int) bool {
+		return out.Exports[a].Name < out.Exports[b].Name
+	})
+
+	return out, nil
+}
