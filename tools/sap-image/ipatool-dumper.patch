diff --git a/cmd/dumpsap/main.go b/cmd/dumpsap/main.go
new file mode 100644
index 0000000..8c93450
--- /dev/null
+++ b/cmd/dumpsap/main.go
@@ -0,0 +1,92 @@
+// Produces the pre-relocated SAP guest image for the browser port.
+//
+// Runs ipatool's own loader once, then writes each populated guest region as a
+// blob plus a manifest of the geometry, the shim symbol table and the entry
+// points. The browser then maps the regions and writes the blobs, with no
+// Mach-O parsing or dyld opcode interpretation of its own.
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+func main() {
+	out := flag.String("out", "sap-image", "directory to write the image into")
+	flag.Parse()
+
+	ctx := context.Background()
+
+	bundle, err := assets.Load(ctx)
+	if err != nil {
+		fail("load Apple SAP assets: %v", err)
+	}
+
+	guest, err := machine.Open(ctx, bundle)
+	if err != nil {
+		fail("open SAP runtime: %v", err)
+	}
+	defer guest.Close()
+
+	dump, err := guest.Dump()
+	if err != nil {
+		fail("dump SAP runtime: %v", err)
+	}
+
+	if err := os.MkdirAll(*out, 0o755); err != nil {
+		fail("create %s: %v", *out, err)
+	}
+
+	for index := range dump.Regions {
+		region := &dump.Regions[index]
+		if len(region.Data) == 0 {
+			continue
+		}
+
+		digest := sha256.Sum256(region.Data)
+		region.SHA256 = hex.EncodeToString(digest[:])
+		region.Blob = region.Name + ".bin"
+
+		if err := os.WriteFile(filepath.Join(*out, region.Blob), region.Data, 0o644); err != nil {
+			fail("write %s: %v", region.Blob, err)
+		}
+	}
+
+	manifest, err := json.MarshalIndent(dump, "", "  ")
+	if err != nil {
+		fail("encode manifest: %v", err)
+	}
+
+	if err := os.WriteFile(filepath.Join(*out, "manifest.json"), append(manifest, 10), 0o644); err != nil {
+		fail("write manifest: %v", err)
+	}
+
+	fmt.Printf("entry points: initialize=%#x exchange=%#x sign=%#x\n",
+		dump.EntryPoints.Initialize, dump.EntryPoints.Exchange, dump.EntryPoints.Sign)
+	fmt.Printf("shim symbols: %d\n", len(dump.Symbols))
+
+	var total uint64
+	for _, region := range dump.Regions {
+		kind := "mapped only"
+		if len(region.Data) > 0 {
+			kind = region.Blob
+			total += uint64(len(region.Data))
+		}
+		fmt.Printf("  %-13s %#014x %9d  %s\n", region.Name, region.Address, region.Size, kind)
+	}
+	fmt.Printf("blob bytes: %d\n", total)
+}
+
+func fail(format string, args ...any) {
+	fmt.Fprintf(os.Stderr, format+"\n", args...)
+	os.Exit(1)
+}
